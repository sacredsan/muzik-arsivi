# Bu dosyanın KOPYASINI ".env" adıyla oluşturup değerleri doldurun.
# .env asla GitHub'a yüklenmez (.gitignore içinde). Bu örnek dosyada gerçek anahtar OLMAMALI.

# --- Supabase (Project Settings > API Keys) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "secret" (sb_secret_...) ya da eski "service_role" (eyJ...) anahtarı. GİZLİ: kimseyle paylaşmayın.
SUPABASE_SERVICE_KEY=

# --- İşçi adı (her bilgisayar/sunucu için farklı olmalı) ---
WORKER_NAME=evdeki-pc

# --- Etiket kaynağı: auto | musicbrainz | lastfm | none ---
# auto = Last.fm anahtarı varsa Last.fm + MusicBrainz birlikte, yoksa sadece MusicBrainz
TAG_PROVIDER=auto
LASTFM_API_KEY=

# MusicBrainz kendini tanıtmanızı ister: uygulama adı/sürüm ( e-posta )
MB_USER_AGENT=MuzikArsivi/0.1 ( sizin-epostaniz@ornek.com )

# --- Analiz motoru: auto | essentia | librosa | basic ---
ANALYZER=auto

# --- Hız sınırı (Deezer: 5 saniyede en fazla 40 istek) ---
DEEZER_REQUESTS=40
DEEZER_PERIOD_SEC=5
BATCH_SIZE=30
# Bir turun en uzun süresi (saniye); dolunca kalan işler kuyruğa iade edilir
RUN_BUDGET_SEC=720
# Bekleyen iş bu sayıyı aşarsa yeni sanatçı taraması yapılmaz
CRAWL_MAX_PENDING=3000
